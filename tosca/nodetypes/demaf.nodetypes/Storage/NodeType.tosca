tosca_definitions_version: demaf

node_types:
  demaf.nodetypes.Storage:
    derived_from: demaf.nodetypes.BaseType
    description: "A storage volume that is attached to a component and holds the component's data persistently."
    metadata:
      targetNamespace: "demaf.nodetypes"
      abstract: "false"
      final: "false"
    properties:
      storage_size:
        description: "The capacity of the storage volume."
        type: STRING
        required: true
        default: 
