tosca_definitions_version: demaf

node_types:
  demaf.nodetypes.Platform:
    derived_from: demaf.nodetypes.BaseType
    description: "A system on which other components are deployed in a form that the system defines, such as container images or application code, and which provides the resources that these components use."
    metadata:
      targetNamespace: "demaf.nodetypes"
      abstract: "false"
      final: "false"
